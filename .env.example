# EgyGram environment template.
#
# NOTE: The Supabase URL and anon key are already baked into the app as
# String.fromEnvironment DEFAULTS in lib/core/config/supabase_config.dart, so
# the app runs correctly out of the box with NO extra configuration. This file
# is informational only; Flutter does NOT read .env files.
#
# To point the app at a DIFFERENT Supabase project/environment, override the
# two compile-time values with --dart-define, e.g. (PowerShell):
#   $env:SUPABASE_ANON_KEY = "eyJ..."
#   flutter run `
#     --dart-define=SUPABASE_URL=https://other.supabase.co `
#     --dart-define=SUPABASE_ANON_KEY=$env:SUPABASE_ANON_KEY
#
# Do NOT pass an empty --dart-define=SUPABASE_ANON_KEY= (it overrides the
# baked-in default with an empty value and the app will refuse to start).
#
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
